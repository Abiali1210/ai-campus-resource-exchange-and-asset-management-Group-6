{
  "name": "circular-campus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:db": "node scripts/test-database.mjs && node scripts/test-workflows.mjs",
    "test:concurrency": "node scripts/test-workflow-concurrency.mjs",
    "test:db:native": "node scripts/test-native-workflows.mjs",
    "test:browser": "playwright test",
    "seed:accounts": "node --env-file=.env.local scripts/provision-demo.mjs",
    "seed:workflows": "node --env-file=.env.local scripts/seed-workflows.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@playwright/test": "^1.50.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "supabase": "^3.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  }
}
