# Browser: project URL and publishable key only. Never prefix a server secret with VITE_.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Hosted synthetic provisioning only: these values target the selected hosted project.
# Do not use for local function serving; use a separate ignored file with local-stack values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Shared synthetic-account password; keep it private and out of Git.
DEMO_ACCOUNT_PASSWORD=
CONFIRM_SYNTHETIC_SEED=no
