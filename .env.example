# Browser: project URL and publishable/anon key only. Never prefix a server secret with VITE_.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Server/provisioning only. Keep .env.local untracked; set Edge secrets separately.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Seed accounts: set a strong local-only password; never commit it.
DEMO_ACCOUNT_PASSWORD=
CONFIRM_SYNTHETIC_SEED=no
